    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Callora</string>
    <string name="onboarding_welcome_body">Callora helps you reduce missed calls when your phone is switched off, out of coverage, or temporarily unreachable — using your operator\'s network-side call forwarding.</string>
    <string name="onboarding_principle_title">How protection works</string>
    <string name="onboarding_principle_body">When your phone is powered off, no Android app can run. Callora therefore configures a forwarding rule inside your operator\'s network in advance. While the phone is off, the network itself forwards eligible calls to your chosen destination.</string>
    <string name="onboarding_sims_title">Your SIM subscriptions</string>
    <string name="onboarding_sims_body">Callora discovers the SIMs in this device and lets you configure a separate destination and forwarding conditions for each eligible subscription.</string>
    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_body">Callora asks only for the permissions its features use: phone state to read SIM information, call permission to hand confirmed forwarding commands to the system dialer, boot completion to re-check protection after restart, and notifications for important status changes.</string>
    <string name="onboarding_privacy_title">Privacy first</string>
    <string name="onboarding_privacy_body">Your configuration stays on this device. Callora has no internet backend, never reads contacts, call logs, SMS or location, and does not upload personal data.</string>
    <string name="onboarding_finish_title">You are in control</string>
    <string name="onboarding_finish_body">Every carrier-side change is shown to you before it happens, with the exact command, destination and possible charges. Callora never changes carrier settings without your confirmation.</string>
    <string name="onboarding_button_next">Next</string>
    <string name="onboarding_button_finish">Get started</string>
    <string name="onboarding_button_skip">Skip for now</string>
    <string name="permission_rationale_phone_state">READ_PHONE_STATE lets Callora discover your SIM subscriptions and their operator. Without it, SIM management cannot work.</string>
    <string name="permission_rationale_call_phone">CALL_PHONE lets Callora hand a confirmed standard GSM forwarding command to the system dialer. You can deny it and press the call button yourself instead.</string>
    <string name="permission_rationale_notifications">Notifications inform you when forwarding status changes or a manual action is required.</string>

