    <!-- Troubleshooting -->
    <string name="troubleshooting_title">Troubleshooting</string>
    <string name="trouble_sim_unavailable_title">SIM unavailable</string>
    <string name="trouble_sim_unavailable_body">Re-seat the SIM, confirm it is enabled in system settings, then pull to refresh the SIMs screen. Callora suspends automation for missing SIMs rather than applying rules to the wrong subscription.</string>
    <string name="trouble_permission_title">Permission denied</string>
    <string name="trouble_permission_body">Grant READ_PHONE_STATE (and optionally CALL_PHONE) from system app settings. Without CALL_PHONE, Callora pre-fills the dialer and you press call yourself.</string>
    <string name="trouble_network_title">Network unavailable</string>
    <string name="trouble_network_body">MMI commands require cellular service. Reconnect to the mobile network, then retry. Bounded retries handle short outages automatically.</string>
    <string name="trouble_unsupported_service_title">Carrier service unsupported</string>
    <string name="trouble_unsupported_service_body">The operator capability is marked NOT VERIFIED or unsupported. Use the manual guide or contact your operator\'s customer care before assuming the rule exists.</string>
    <string name="trouble_carrier_rejection_title">Carrier rejection</string>
    <string name="trouble_carrier_rejection_body">Note the exact carrier message, check service provisioning and tariff eligibility, then retry manually. Callora will not auto-retry a rejected chargeable operation.</string>
    <string name="trouble_mmi_title">MMI/USSD failure</string>
    <string name="trouble_mmi_body">Confirm the standard GSM code and destination formatting, try the query code, and verify the correct SIM performed the command on dual-SIM devices.</string>
    <string name="trouble_unknown_state_title">Unknown forwarding state</string>
    <string name="trouble_unknown_state_body">Android does not let third-party apps parse MMI responses. Dial the query code yourself and record the result in Callora to keep the status honest.</string>
    <string name="trouble_retry_title">Retry limit reached</string>
    <string name="trouble_retry_body">The operation exhausted its safe retry budget. Review the failure reason in History and start a new confirmed operation when ready.</string>
    <string name="trouble_conflict_title">Configuration conflict</string>
    <string name="trouble_conflict_body">An identical operation is already in flight for this SIM and condition. Wait for it to finish before requesting another.</string>
    <string name="trouble_api_title">Unsupported Android API</string>
    <string name="trouble_api_body">Programmatic call-forwarding control is restricted to carrier-privileged apps. Callora uses the user-confirmed dialer workflow instead.</string>
    <string name="trouble_destination_title">Destination validation failure</string>
    <string name="trouble_destination_body">Use a valid Bangladesh mobile number in 01XXXXXXXXX or +8801XXXXXXXXX format. Validation checks syntax only — it cannot prove the number is active or eligible.</string>

