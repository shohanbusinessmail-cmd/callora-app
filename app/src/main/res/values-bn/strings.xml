    <string name="about_description">Callora বাংলাদেশের জন্য তৈরি একটি স্মার্ট কল কন্টিনিউটি ও কল ফরওয়ার্ডিং সহকারী, যা সৎ স্ট্যাটাস রিপোর্টিং এবং ক্যারিয়ার-নিরাপদ ওয়ার্কফ্লোতে গড়ে উঠেছে।</string>
    <string name="about_license_note">রিপোজিটরি মালিক এখনো কোনো ওপেন-সোর্স লাইসেন্স নির্বাচন করেননি। ডিফল্টভাবে সর্বস্বত্ব সংরক্ষিত।</string>

    <!-- Troubleshooting -->
    <string name="troubleshooting_title">সমস্যা সমাধান</string>
    <string name="trouble_sim_unavailable_title">সিম উপলব্ধ নেই</string>
    <string name="trouble_sim_unavailable_body">সিম পুনরায় বসান, সিস্টেম সেটিংসে সিম চালু আছে কিনা দেখুন, তারপর সিম স্ক্রিন রিফ্রেশ করুন। Callora ভুল সাবস্ক্রিপশনে নিয়ম প্রয়োগের বদলে অনুপস্থিত সিমের অটোমেশন স্থগিত করে।</string>
    <string name="trouble_permission_title">অনুমতি প্রত্যাখ্যাত</string>
    <string name="trouble_permission_body">সিস্টেম অ্যাপ সেটিংস থেকে READ_PHONE_STATE (এবং চাইলে CALL_PHONE) দিন। CALL_PHONE ছাড়া Callora ডায়ালার পূরণ করে দেবে, আপনি নিজে কল চাপবেন।</string>
    <string name="trouble_network_title">নেটওয়ার্ক উপলব্ধ নেই</string>
    <string name="trouble_network_body">MMI কমান্ডের জন্য সেলুলার সেবা প্রয়োজন। মোবাইল নেটওয়ার্কে পুনরায় সংযুক্ত হয়ে আবার চেষ্টা করুন। সীমিত রিট্রাই সংক্ষিপ্ত বিভ্রাট সামলায়।</string>
    <string name="trouble_unsupported_service_title">ক্যারিয়ার সেবা সমর্থিত নয়</string>
    <string name="trouble_unsupported_service_body">অপারেটর সক্ষমতা NOT VERIFIED বা অসমর্থিত চিহ্নিত। নিয়মটি আছে ধরে নেওয়ার আগে ম্যানুয়াল গাইড ব্যবহার করুন বা অপারেটরের কাস্টমার কেয়ারে যোগাযোগ করুন।</string>
    <string name="trouble_carrier_rejection_title">ক্যারিয়ার প্রত্যাখ্যান</string>
    <string name="trouble_carrier_rejection_body">ক্যারিয়ারের সঠিক বার্তাটি নোট করুন, সেবা প্রোভিশনিং ও ট্যারিফ যোগ্যতা যাচাই করে ম্যানুয়ালি আবার চেষ্টা করুন। প্রত্যাখ্যাত চার্জযোগ্য অপারেশন Callora স্বয়ংক্রিয়ভাবে রিট্রাই করে না।</string>
    <string name="trouble_mmi_title">MMI/USSD ব্যর্থতা</string>
    <string name="trouble_mmi_body">স্ট্যান্ডার্ড GSM কোড ও গন্তব্য ফরম্যাট যাচাই করুন, কোয়েরি কোড চেষ্টা করুন এবং ডুয়াল-সিম ডিভাইসে সঠিক সিম কমান্ড চালিয়েছে কিনা নিশ্চিত হন।</string>
    <string name="trouble_unknown_state_title">অজানা ফরওয়ার্ডিং স্ট্যাটাস</string>
    <string name="trouble_unknown_state_body">থার্ড-পার্টি অ্যাপ MMI উত্তর পার্স করতে পারে না। নিজে কোয়েরি কোড ডায়াল করুন এবং স্ট্যাটাস সৎ রাখতে Callora-তে ফলাফল লিপিবদ্ধ করুন।</string>
    <string name="trouble_retry_title">রিট্রাই সীমা শেষ</string>
    <string name="trouble_retry_body">অপারেশনটির নিরাপদ রিট্রাই বাজেট শেষ হয়েছে। ইতিহাস থেকে ব্যর্থতার কারণ দেখুন এবং প্রস্তুত হলে নতুন নিশ্চিত অপারেশন শুরু করুন।</string>
    <string name="trouble_conflict_title">কনফিগারেশন দ্বন্দ্ব</string>
    <string name="trouble_conflict_body">এই সিম ও শর্তের জন্য অভিন্ন একটি অপারেশন আগে থেকেই চলমান। নতুন অনুরোধের আগে এটি শেষ হওয়ার অপেক্ষা করুন।</string>
    <string name="trouble_api_title">অসমর্থিত অ্যান্ড্রয়েড API</string>
    <string name="trouble_api_body">প্রোগ্রাম্যাটিক কল ফরওয়ার্ডিং নিয়ন্ত্রণ ক্যারিয়ার-প্রিভিলেজড অ্যাপের জন্য সংরক্ষিত। Callora তার বদলে ব্যবহারকারী-নিশ্চিত ডায়ালার ওয়ার্কফ্লো ব্যবহার করে।</string>
    <string name="trouble_destination_title">গন্তব্য যাচাইকরণ ব্যর্থ</string>
    <string name="trouble_destination_body">বৈধ বাংলাদেশি মোবাইল নম্বর 01XXXXXXXXX বা +8801XXXXXXXXX ফরম্যাটে লিখুন। যাচাই শুধু সিনট্যাক্স পরীক্ষা করে — নম্বর সক্রিয় বা যোগ্য কিনা তা প্রমাণ করে না।</string>

