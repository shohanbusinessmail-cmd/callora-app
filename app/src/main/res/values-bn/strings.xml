    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Callora-তে স্বাগতম</string>
    <string name="onboarding_welcome_body">ফোন বন্ধ থাকলে, নেটওয়ার্ক কভারেজের বাইরে থাকলে বা সাময়িকভাবে অপ্রাপ্য হলে — আপনার অপারেটরের নেটওয়ার্ক-সাইড কল ফরওয়ার্ডিং ব্যবহার করে Callora মিস কল কমাতে সাহায্য করে।</string>
    <string name="onboarding_principle_title">সুরক্ষা যেভাবে কাজ করে</string>
    <string name="onboarding_principle_body">ফোন সম্পূর্ণ বন্ধ থাকলে কোনো অ্যান্ড্রয়েড অ্যাপ চলতে পারে না। তাই Callora আগে থেকেই আপনার অপারেটরের নেটওয়ার্কে একটি ফরওয়ার্ডিং নিয়ম সেট করে। ফোন বন্ধ থাকা অবস্থায় নেটওয়ার্ক নিজেই যোগ্য কলগুলো আপনার নির্বাচিত নম্বরে পাঠিয়ে দেয়।</string>
    <string name="onboarding_sims_title">আপনার সিম সাবস্ক্রিপশন</string>
    <string name="onboarding_sims_body">Callora ডিভাইসের সিম শনাক্ত করে এবং প্রতিটি যোগ্য সাবস্ক্রিপশনের জন্য আলাদা গন্তব্য নম্বর ও ফরওয়ার্ডিং শর্ত সেট করার সুযোগ দেয়।</string>
    <string name="onboarding_permissions_title">অনুমতি</string>
    <string name="onboarding_permissions_body">Callora শুধু প্রয়োজনীয় অনুমতিই চায়: সিম তথ্য পড়তে ফোন স্টেট, নিশ্চিত করা ফরওয়ার্ডিং কমান্ড সিস্টেম ডায়ালারে পাঠাতে কল অনুমতি, রিস্টার্টের পর সুরক্ষা যাচাইয়ে বুট কমপ্লিশন এবং গুরুত্বপূর্ণ স্ট্যাটাস পরিবর্তনে নোটিফিকেশন।</string>
    <string name="onboarding_privacy_title">গোপনীয়তা প্রথমে</string>
    <string name="onboarding_privacy_body">আপনার কনফিগারেশন এই ডিভাইসেই থাকে। Callora-র কোনো ইন্টারনেট ব্যাকএন্ড নেই; এটি কন্ট্যাক্ট, কল লগ, এসএমএস বা লোকেশন কখনো পড়ে না এবং ব্যক্তিগত তথ্য আপলোড করে না।</string>
    <string name="onboarding_finish_title">নিয়ন্ত্রণ আপনার হাতে</string>
    <string name="onboarding_finish_body">প্রতিটি নেটওয়ার্ক-সাইড পরিবর্তনের আগে সঠিক কমান্ড, গন্তব্য নম্বর ও সম্ভাব্য চার্জ আপনাকে দেখানো হবে। আপনার নিশ্চিতকরণ ছাড়া Callora ক্যারিয়ার সেটিংস পরিবর্তন করে না।</string>
    <string name="onboarding_button_next">পরবর্তী</string>
    <string name="onboarding_button_finish">শুরু করুন</string>
    <string name="onboarding_button_skip">এখনই নয়</string>
    <string name="permission_rationale_phone_state">READ_PHONE_STATE অনুমতি Callora-কে আপনার সিম সাবস্ক্রিপশন ও অপারেটর শনাক্ত করতে দেয়। এটি ছাড়া সিম ব্যবস্থাপনা কাজ করবে না।</string>
    <string name="permission_rationale_call_phone">CALL_PHONE অনুমতি Callora-কে নিশ্চিত করা স্ট্যান্ডার্ড GSM ফরওয়ার্ডিং কমান্ড সিস্টেম ডায়ালারে পাঠাতে দেয়। অস্বীকার করলে Callora নম্বরটি পূরণ করে দেবে, আপনি নিজে কল বোতাম চাপবেন।</string>
    <string name="permission_rationale_notifications">ফরওয়ার্ডিং স্ট্যাটাস পরিবর্তন বা ম্যানুয়াল অ্যাকশনের প্রয়োজন হলে নোটিফিকেশন আপনাকে জানায়।</string>

